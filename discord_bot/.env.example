# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

DRIVER=~httpx+~websockets

# Discord bot token & intents — must match Developer Portal settings.
# message_content must be true for no-@ channels (and Portal → Bot → Message Content Intent On).
# Without a channel whitelist below, true would listen to all visible guild channels.
DISCORD_BOTS=[{"token": "YOUR_BOT_TOKEN_HERE", "intent": {"guild_messages": true, "direct_messages": true, "message_content": true}, "application_commands": {"*": ["*"]}}]

# Comma-separated Discord channel snowflakes: commands work without @ in these guild channels.
# Other guild channels still require a real @ (or reply to the bot). DMs unchanged.
# Right-click channel → Copy Channel ID (enable Developer Mode). Example: 123456789012345678
DISCORD_NO_MENTION_CHANNELS=

# gsuid_core WebSocket (same machine: 127.0.0.1)
gsuid_core_host=127.0.0.1
gsuid_core_port=8765
gsuid_core_ws_token=
gsuid_core_botid=NoneBot2
