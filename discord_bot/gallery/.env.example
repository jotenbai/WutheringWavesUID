# Gallery（VPS / 公网经 Nginx）
GALLERY_DATA_DIR=./data
GALLERY_HOST=127.0.0.1
GALLERY_PORT=8787
GALLERY_PUBLIC_PREFIX=/gallery
GALLERY_DEFAULT_SUBMITTER=jo
GALLERY_DEFAULT_REVIEWER=jo
GALLERY_ASSET_VERSION=11
GALLERY_OFFICIAL_PILE_DIR=/home/admin/gsuid_core/data/WutheringWavesUID/resource/role_pile

# 只读绑定库 / 与「更新图集」对齐的管理员来源（自动读取 gscore masters + superusers，全生态同权）
GALLERY_GSCORE_DB=/home/admin/gsuid_core/data/GsData.db
GALLERY_GSCORE_CONFIG=/home/admin/gsuid_core/data/config.json

# Discord OAuth（Discord Developer Portal → OAuth2）
# Redirects 须精确包含：
#   https://core.jotenbai.moe/gallery/auth/callback
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://core.jotenbai.moe/gallery/auth/callback
GALLERY_SESSION_SECRET=
GALLERY_SESSION_HTTPS_ONLY=1

# 审核结果私信投稿者 + 待审轮换提醒管理员（填「守岸人」Bot Token；与 OAuth Secret 不同）
# GALLERY_DISCORD_BOT_TOKEN=

# 待审 > 0 时，每天 UTC+9 20:00 只私信轮换中的下一位（masters 在前 + superusers）
# 无积压不提醒、不跳号；GALLERY_ADMIN_REMIND=0 关闭
# GALLERY_ADMIN_REMIND=1
# GALLERY_ADMIN_REMIND_HOUR=20
# 时区默认固定 UTC+9；一般无需改
# GALLERY_ADMIN_REMIND_TZ=UTC+9
