[Unit]
Description=Shorekeeper panel gallery (browse + API)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/gallery
EnvironmentFile=-%h/gallery/.env
ExecStart=%h/gallery/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
